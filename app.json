{
  "expo": {
    "name": "Garad AI",
    "slug": "garad-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "garadai",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "ai.garad.app",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Garad AI uses the camera so you can take a photo to send in a chat.",
        "NSPhotoLibraryUsageDescription": "Garad AI uses your photos so you can attach images to a chat.",
        "NSMicrophoneUsageDescription": "Garad AI uses the microphone for voice chat and dictation."
      }
    },
    "android": {
      "package": "ai.garad.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#F8F8F6",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#f8f8f6",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#111513"
          }
        }
      ],
      "expo-localization",
      "expo-web-browser",
      "./plugins/withReleaseSigning"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "siteUrl": "https://garad.ai",
      "startPath": "/chat"
    }
  }
}
