<?xml version="1.0" encoding="utf-8"?>
<!-- Plain http:// is allowed only for test servers on this network (the local XAMPP copy of the
     website: the Android emulator's 10.0.2.2 and the development PC's Wi-Fi address). Everything
     else — the live garad.ai — must use https. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">192.168.0.16</domain>
        <domain includeSubdomains="false">192.168.100.77</domain>
    </domain-config>
</network-security-config>
