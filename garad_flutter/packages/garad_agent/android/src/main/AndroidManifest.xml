<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Lets the agent show app names ("WhatsApp") instead of package names. -->
  <queries>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
  </queries>
  <application>
    <!-- Garad agent: works only after the user turns it on in Accessibility settings. -->
    <service
      android:name="ai.garad.agent.GaradAccessibilityService"
      android:exported="true"
      android:label="@string/garad_agent_service_label"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/garad_accessibility_service" />
    </service>
    <!-- Garad messages and calls: works only after the user allows notification access. -->
    <service
      android:name="ai.garad.agent.GaradNotificationListener"
      android:exported="true"
      android:label="@string/garad_agent_service_label"
      android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
      <intent-filter>
        <action android:name="android.service.notification.NotificationListenerService" />
      </intent-filter>
    </service>
  </application>
</manifest>
